# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Anthropic ──────────────────────────────────────────────
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio ─────────────────────────────────────────────────
# Get at: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX     # Your Twilio number (E.164 format)
YOUR_PHONE_NUMBER=+1XXXXXXXXXX       # Your personal number to receive texts

# ── Vapi.ai ────────────────────────────────────────────────
# Get at: https://dashboard.vapi.ai/
VAPI_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_DOCTOR_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VAPI_PHARMACY_ASSISTANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Google Sheets ──────────────────────────────────────────
# Spreadsheet ID is in the URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here
# Sheet tab name (default: Sheet1)
GOOGLE_SHEET_NAME=Sheet1

# Google auth — choose ONE method:

# Option A: API Key (read-only access, simpler)
# Get at: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=AIzaSy...

# Option B: Service Account JSON (read+write, required for auto-updating refill dates)
# Download JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Set this to the path of the downloaded file — never commit the file itself
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./credentials.json

# ── Make.com (for self-hosted webhook secret validation) ───
# Set a random secret string in Make.com and mirror it here
MAKE_WEBHOOK_SECRET=your-random-secret-here
